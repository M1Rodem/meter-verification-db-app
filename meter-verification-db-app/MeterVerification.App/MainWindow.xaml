<Window x:Class="MeterVerification.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поверка счетчиков" 
        Height="600" 
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="btnLoad" Content="Загрузить данные из БД" 
                    Width="150" Height="35" Margin="5" Click="BtnLoad_Click"/>
            <Button x:Name="btnAddTest" Content="Добавить тестовые данные" 
                    Width="180" Height="35" Margin="5" Click="BtnAddTest_Click"/>
        </StackPanel>

        <DataGrid x:Name="dataGrid" 
                  Grid.Row="1" 
                  Margin="10"
                  AutoGenerateColumns="True"
            IsReadOnly="True"
                  SelectionMode="Single">
        </DataGrid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="tbStatus" Text="Готов к работе"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="tbCount" Text="Записей: 0" Margin="10,0,0,0"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>